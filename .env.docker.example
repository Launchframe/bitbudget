# Copy to .env for docker compose: cp .env.docker.example .env
# See docs/self-hosting.md — especially VPN + URL variables.

# ─── Postgres (compose sets DATABASE_URL; override password in production) ───
POSTGRES_USER=bitbudget
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=bitbudget

# ─── Auth.js (required) ───
# Generate: npx auth secret
AUTH_SECRET=change-me-at-least-32-characters-long
AUTH_TRUST_HOST=true

# Must match the URL in your phone/browser when using the app.
# VPN example (Tailscale): https://100.x.x.x:3000 or http://nas.tailnet-abc.ts.net:3000
# LAN-only example: http://192.168.1.50:3000
AUTH_URL=http://192.168.1.50:3000
NEXTAUTH_URL=http://192.168.1.50:3000
NEXT_PUBLIC_APP_URL=http://192.168.1.50:3000

# ─── Cron (required for recurring + payday funding on self-host) ───
# openssl rand -hex 32
CRON_SECRET=change-me-cron-secret

# ─── Email OTP (recommended) ───
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── Optional integrations (leave blank to disable) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OPENAI_API_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_SECRET=
SENDGRID_INBOUND_WEBHOOK_PUBLIC_KEY=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_WEBHOOK_URL=
BITBUDGET_NOSTR_NSEC=
BITBUDGET_NOSTR_RELAYS=

# Never set in production:
# E2E_TEST=true
