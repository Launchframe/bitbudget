# Database — Vercel Postgres (Neon) provides both automatically
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="your-secret-here-at-least-32-characters"

# OAuth providers (leave blank to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Gmail SMTP — login OTP, notification verification, product email (https://myaccount.google.com/apppasswords)
# Setup guide: docs/outbound-messaging.md
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# OpenAI API key for receipt OCR scanning (https://platform.openai.com/api-keys)
OPENAI_API_KEY=""

# SendGrid Inbound Parse: base64 public key from a Parse webhook security policy (signature enabled).
# Required in production so only SendGrid can POST /api/webhooks/inbound-email.
# https://www.twilio.com/docs/sendgrid/for-developers/parsing-email/securing-your-parse-webhooks
SENDGRID_INBOUND_WEBHOOK_PUBLIC_KEY=""

# Twilio SMS webhook: Auth Token + exact public URL of this webhook (as configured in Twilio console)
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_WEBHOOK_URL="https://your-domain.com/api/webhooks/sms"

# Plaid (bank sync — premium)
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
PLAID_WEBHOOK_SECRET=""

# Vercel Cron — set automatically by Vercel, or generate your own for local testing
CRON_SECRET=""

# Public app URL for referral links, QR codes, and share targets (production: https://bitbudget.io)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Playwright e2e only — never set E2E_TEST in production. See AGENTS.md (Testing → End-to-end).
# When true: fixed OTP for @bitbudget.test sign-in; lib/notify skips outbound email/DM.
# E2E_TEST="true"
# E2E_EMAIL_CODE="424242"

# Service Nostr account for DM notifications (nsec or hex). Optional if not using Nostr DMs.
# Use a dedicated key per environment; see docs/outbound-messaging.md
BITBUDGET_NOSTR_NSEC=""
# Comma-separated clearnet wss:// relay URLs (optional; defaults used when unset).
# MVP: use public relays only. Tor/.onion relays require post-MVP Tor publisher — docs/outbound-messaging.md
BITBUDGET_NOSTR_RELAYS=""
