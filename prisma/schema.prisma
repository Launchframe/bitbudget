datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Auth.js required models ────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  // Nostr identity
  nostrPubkey String? @unique

  // E2E encryption: encrypted privacy key + salt (for Web 2.0 users)
  encryptedPrivacyKey String?
  privacyKeySalt      String?

  // Budgeting settings
  monthlyIncome           Float    @default(0)
  payCadence              String   @default("monthly") // "monthly" | "bimonthly"
  onboardingComplete      Boolean  @default(false)
  btcDisplayUnit          String   @default("sats") // "sats" | "btc"
  opportunityCostEnabled  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts              Account[]
  sessions              Session[]
  envelopes             Envelope[]
  transactions          Transaction[]
  tags                  Tag[]
  recurringTransactions RecurringTransaction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App models ─────────────────────────────────────────────────────

model Envelope {
  id              String  @id @default(cuid())
  userId          String
  name            String
  monthlyAllotment Float  @default(0)
  color           String  @default("#F7931A")
  icon            String?
  archived        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  envelopeId String
  date       DateTime
  payee      String   // encrypted for privacy
  amount     Float
  type       String   // "expense" | "credit"
  tags       String   @default("[]") // JSON array of tag names
  notes      String?
  satsAmount Int?     // BTC equivalent in satoshis (1 BTC = 100,000,000 sats)

  recurringId String?

  createdAt DateTime @default(now())

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope  Envelope              @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  recurring RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([envelopeId])
  @@index([date])
  @@index([recurringId])
}

model RecurringTransaction {
  id         String   @id @default(cuid())
  userId     String
  envelopeId String
  payee      String
  amount     Float
  type       String   // "expense" | "credit"
  tags       String   @default("[]")
  notes      String?  // encrypted for privacy
  cadence    String   // "weekly" | "biweekly" | "monthly" | "quarterly" | "annual"

  nextDueDate DateTime
  endDate     DateTime?
  active      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope     Envelope      @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([active, nextDueDate])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  name   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model EmailCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model BtcPriceCache {
  id       String   @id @default(cuid())
  date     String   @unique // YYYY-MM-DD
  priceUsd Float
  fetchedAt DateTime @default(now())
}
