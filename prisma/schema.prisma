datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Auth.js required models ────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  // Nostr identity
  nostrPubkey String? @unique

  // E2E encryption: encrypted privacy key + salt (for Web 2.0 users)
  encryptedPrivacyKey String?
  privacyKeySalt      String?

  // Budgeting settings
  monthlyIncome             Float     @default(0)
  payCadence                String    @default("monthly") // monthly | bimonthly | weekly | biweekly | irregular | mixed | daily (daily non-production only)
  payDays                   Int[]     @default([])
  payDayOfWeek              Int?
  lastPaydayAt              DateTime?
  estimatedAnnualIncome     Decimal?  @db.Decimal(12, 2)
  sweepDefaultPolicy        String    @default("reset") // reset | carry_forward | capped
  sweepDefaultCapMultiplier Decimal?  @db.Decimal(4, 2)
  savingsExperience         String    @default("engaged") // engaged | dismissed
  onboardingComplete        Boolean   @default(false)
  onboardingCompletedAt     DateTime?
  walkthroughCompleted      Boolean   @default(false)
  setupGuideSnoozedUntil    DateTime?
  setupGuideDismissed       Boolean   @default(false)
  setupGuideShowOnDashboard Boolean   @default(true)
  btcDisplayUnit            String    @default("sats") // "sats" | "btc"
  opportunityCostEnabled    Boolean   @default(false)
  role                      String?   @default("user")
  publicKey                 String?
  receiptInboxToken         String?   @unique
  notificationIngestToken   String?   @unique // Android DIY webhook ingest (see docs/android-notification-forwarding.md)
  lastVisitedAt             DateTime?
  remindersEnabled          Boolean   @default(false)
  reminderTime              String?   @default("20:00")
  emailFeatureUpdates       Boolean   @default(true)
  emailFeedbackRequests     Boolean   @default(true)
  emailRecurringReminders   Boolean   @default(true)
  emailRenewalReminders     Boolean   @default(true)
  emailImportAlerts         Boolean   @default(true)
  emailUnsubscribeToken     String    @unique @default(dbgenerated("gen_random_uuid()::text"))
  nostrDmEnabled            Boolean   @default(false)
  subscriptionTier          String    @default("free")
  // Set when a free user taps Upgrade to Premium (checkout not yet available).
  premiumInterestAt      DateTime?
  premiumGratisUntil     DateTime?
  premiumTrialUntil      DateTime?
  referredByCodeId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts                   Account[]
  sessions                   Session[]
  envelopes                  Envelope[]
  transactions               Transaction[]
  tags                       Tag[]
  recurringTransactions      RecurringTransaction[]
  pendingTransactions        PendingTransaction[]
  shortcuts                  TransactionShortcut[]
  approvedSenders            ApprovedReceiptSender[]    @relation("ApprovedSenderAdmin")
  auditLogs                  AuditLog[]                 @relation("AuditLogAdmin")
  plaidItems                 PlaidItem[]
  plaidImportedTransactions  PlaidImportedTransaction[]
  connectedEmails            ConnectedEmailAccount[]
  payeeMappings              PayeeEnvelopeMapping[]
  payeeDisplayAliases        PayeeDisplayAlias[]
  pushSubscriptions          PushSubscription[]
  codesCreated               ReferralCode[]             @relation("CodesCreated")
  referralsMade              Referral[]                 @relation("ReferralsMade")
  referralReceived           Referral?                  @relation("ReferralReceived")
  survey                     Survey?
  referredByCode             ReferralCode?              @relation("ReferredByCode", fields: [referredByCodeId], references: [id], onDelete: SetNull)
  notificationEmails         UserNotificationEmail[]
  envelopeFundingBatches     EnvelopeFundingBatch[]
  savingsGoals               SavingsGoal[]
  achievements               UserAchievement[]
  pendingStatementBatches    PendingStatementBatch[]
}

model UserNotificationEmail {
  id         String   @id @default(cuid())
  userId     String
  email      String
  verifiedAt DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId])
}

model ReferralCode {
  id         String   @id @default(cuid())
  code       String   @unique
  type       String
  ownerId    String
  label      String?
  maxUses    Int      @default(1)
  usedCount  Int      @default(0)
  visitCount Int      @default(0)
  startsAt   DateTime @default(now())
  expiresAt  DateTime
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  owner         User       @relation("CodesCreated", fields: [ownerId], references: [id], onDelete: Cascade)
  referrals     Referral[]
  referredUsers User[]     @relation("ReferredByCode")

  @@index([ownerId])
  @@index([type])
}

model Referral {
  id          String    @id @default(cuid())
  codeId      String
  referrerId  String
  refereeId   String    @unique
  status      String    @default("accepted")
  shareMethod String?
  acceptedAt  DateTime  @default(now())
  activatedAt DateTime?

  code     ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  referrer User         @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User         @relation("ReferralReceived", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([codeId])
}

model Survey {
  id              String    @id @default(cuid())
  userId          String    @unique
  triggerType     String
  rating          String?
  favoriteFeature String?
  leastFavorite   String?
  comments        String?
  canContact      Boolean?
  currentStep     Int       @default(1)
  completedAt     DateTime?
  dismissedAt     DateTime?
  dismissType     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([completedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App models ─────────────────────────────────────────────────────

model Envelope {
  id                 String   @id @default(cuid())
  userId             String
  name               String
  monthlyAllotment   Float    @default(0)
  color              String   @default("#F7931A")
  icon               String?
  archived           Boolean  @default(false)
  /// When set, envelope is hidden and transactions leave the active ledger until restored or purged.
  deletedAt          DateTime?
  /// null | savings — system-managed Savings envelope
  systemRole         String?
  sweepPolicy        String   @default("reset") // reset | carry_forward | capped
  sweepCapMultiplier Decimal? @db.Decimal(4, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  pendingTransactions   PendingTransaction[]
  shortcuts             TransactionShortcut[]
  payeeMappings         PayeeEnvelopeMapping[]

  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  envelopeId String
  date       DateTime
  payee      String // encrypted for privacy
  amount     Float
  type       String // "expense" | "credit"
  tags       String   @default("[]") // JSON array of tag names
  notes      String?
  satsAmount Int? // BTC equivalent in satoshis (1 BTC = 100,000,000 sats)
  source     String   @default("manual")

  /// Client-computed HMAC fingerprint for idempotent CSV imports. Only set on imported rows.
  /// The server cannot derive it (the HMAC key is the client-only privacy-key seed).
  dedupeKey String?

  recurringId String?

  /// Hidden allocation legs excluded from global transaction history
  excludeFromMainHistory Boolean @default(false)
  fundingBatchId         String?
  fundingBatch           EnvelopeFundingBatch? @relation(fields: [fundingBatchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope  Envelope              @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  recurring RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([envelopeId])
  @@index([date])
  @@index([recurringId])
  @@index([fundingBatchId])
}

// NOTE: A partial unique index on (userId, dedupeKey) WHERE dedupeKey IS NOT NULL
// is created via raw SQL in the migration (Prisma does not support partial unique
// indexes in the schema DSL). It powers createMany({ skipDuplicates: true }) for imports.

model EnvelopeFundingBatch {
  id        String   @id @default(cuid())
  userId    String
  periodKey String
  kind      String   @default("fund") // fund | sweep | rebalance | statement_import
  config    Json?    // creation-time config; for statement_import: { institutionName, dateFrom, dateTo, format, transactionCount }
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, periodKey, kind])
  @@index([userId])
}

model SavingsGoal {
  id                String    @id @default(cuid())
  userId            String
  periodKey         String    // YYYY-MM or default
  targetAmount      Decimal   @db.Decimal(12, 2)
  graceEndsAt       DateTime?
  closedAt          DateTime?
  startBalance      Decimal?  @db.Decimal(12, 2)
  endBalance        Decimal?  @db.Decimal(12, 2)
  actualSavedAmount Decimal?  @db.Decimal(12, 2)
  netSavingsInflow  Decimal?  @db.Decimal(12, 2)
  achievedGoal      Boolean?
  progressPct       Decimal?  @db.Decimal(8, 4)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey])
  @@index([userId, closedAt])
}

model UserAchievement {
  id       String   @id @default(cuid())
  userId   String
  code     String
  earnedAt DateTime @default(now())
  metadata Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId, earnedAt])
}

model RecurringTransaction {
  id         String  @id @default(cuid())
  userId     String
  envelopeId String
  payee      String
  amount     Float
  type       String // "expense" | "credit"
  tags       String  @default("[]")
  notes      String? // encrypted for privacy
  cadence    String // "weekly" | "biweekly" | "monthly" | "quarterly" | "annual"

  nextDueDate DateTime
  endDate     DateTime?
  active      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope     Envelope      @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([active, nextDueDate])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  name   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model EmailCode {
  id             String   @id @default(cuid())
  email          String
  code           String
  expiresAt      DateTime
  failedAttempts Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([email])
}

model BtcPriceCache {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD
  priceUsd  Float
  fetchedAt DateTime @default(now())
}

// ─── Low-friction capture models ────────────────────────────────────

model PendingTransaction {
  id                  String   @id @default(cuid())
  userId              String
  source              String
  payee               String
  amount              Float
  date                DateTime
  notes               String?
  suggestedEnvelopeId String?
  confidence          Float
  rawInput            String?
  tags                String?
  createdAt           DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope Envelope? @relation(fields: [suggestedEnvelopeId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
}

model TransactionShortcut {
  id            String   @id @default(cuid())
  userId        String
  payee         String
  defaultAmount Float?
  envelopeId    String
  label         String?
  usageCount    Int      @default(0)
  createdAt     DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope Envelope @relation(fields: [envelopeId], references: [id])

  @@index([userId])
}

model ApprovedReceiptSender {
  id            String   @id @default(cuid())
  senderPattern String   @unique
  displayName   String
  addedBy       String
  createdAt     DateTime @default(now())

  admin User @relation("ApprovedSenderAdmin", fields: [addedBy], references: [id])
}

model PendingSenderReview {
  id              String   @id @default(cuid())
  senderAddress   String
  samplePayee     String?
  sampleAmount    Float?
  occurrenceCount Int      @default(1)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  status          String   @default("pending")
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  admin User @relation("AuditLogAdmin", fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([action])
  @@index([createdAt])
}

model CronRun {
  id           String    @id @default(cuid())
  name         String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String
  errorClass   String?
  errorMessage String?
  processed    Int?
  durationMs   Int?

  @@index([name, startedAt])
  @@index([status])
  @@index([startedAt])
}

model OpsEvent {
  id            String   @id @default(cuid())
  severity      String
  source        String
  title         String
  body          String
  fingerprint   String?
  sentryEventId String?
  channelStatus Json?
  createdAt     DateTime @default(now())

  @@index([severity])
  @@index([fingerprint, createdAt])
  @@index([createdAt])
}

model PlaidItem {
  id                     String   @id @default(cuid())
  userId                 String
  plaidItemId            String   @unique
  accessToken            String
  institutionName        String?
  consentTimestamp       DateTime @default(now())
  createdAt              DateTime @default(now())
  transactionsSyncCursor String?

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts PlaidAccount[]

  @@index([userId])
}

model PlaidImportedTransaction {
  id                 String   @id @default(cuid())
  userId             String
  plaidTransactionId String   @unique
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PlaidAccount {
  id          String  @id @default(cuid())
  plaidItemId String
  accountName String
  mask        String?
  type        String

  plaidItem PlaidItem @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
}

model PayeeEnvelopeMapping {
  id         String @id @default(cuid())
  userId     String
  payeeHash  String
  envelopeId String
  count      Int    @default(1)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@unique([userId, payeeHash])
  @@index([userId])
}

// User-defined map from statement/OCR text (normalized) to preferred payee label (e.g. WM SUPERCENTER to Walmart).
model PayeeDisplayAlias {
  id               String   @id @default(cuid())
  userId           String
  sourceNormalized String
  canonicalPayee   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceNormalized])
  @@index([userId, updatedAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ConnectedEmailAccount {
  id           String    @id @default(cuid())
  userId       String
  provider     String
  accessToken  String
  refreshToken String?
  email        String
  lastScanAt   DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Pending statement batch created when an email attachment is detected as a bank statement.
/// Transactions are encrypted server-side with the user's public key and held here until
/// the user reviews and imports them via StatementImporterDialog (pendingBatchId mode).
model PendingStatementBatch {
  id               String   @id @default(cuid())
  userId           String
  source           String   // "email_statement"
  institutionName  String?  // encrypted ciphertext (user's pubkey)
  format           String   // "fold_csv" | "fold_pdf" | ...
  transactions     Json     // ParsedTransaction[] with payee/notes encrypted via server-encrypt
  dateFrom         String?  // YYYY-MM-DD
  dateTo           String?  // YYYY-MM-DD
  transactionCount Int
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}
