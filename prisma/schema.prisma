datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Auth.js required models ────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  // Nostr identity
  nostrPubkey String? @unique

  // E2E encryption: encrypted privacy key + salt (for Web 2.0 users)
  encryptedPrivacyKey String?
  privacyKeySalt      String?

  // Budgeting settings
  monthlyIncome           Float    @default(0)
  payCadence              String   @default("monthly") // "monthly" | "bimonthly"
  onboardingComplete      Boolean  @default(false)
  btcDisplayUnit          String   @default("sats") // "sats" | "btc"
  opportunityCostEnabled  Boolean  @default(false)
  role      String? @default("user")
  publicKey String?
  receiptInboxToken String? @unique
  lastVisitedAt DateTime?
  remindersEnabled Boolean @default(false)
  reminderTime    String?  @default("20:00")
  subscriptionTier String @default("free")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts              Account[]
  sessions              Session[]
  envelopes             Envelope[]
  transactions          Transaction[]
  tags                  Tag[]
  recurringTransactions RecurringTransaction[]
  pendingTransactions PendingTransaction[]
  shortcuts           TransactionShortcut[]
  approvedSenders     ApprovedReceiptSender[] @relation("ApprovedSenderAdmin")
  auditLogs           AuditLog[]              @relation("AuditLogAdmin")
  plaidItems                 PlaidItem[]
  plaidImportedTransactions  PlaidImportedTransaction[]
  connectedEmails     ConnectedEmailAccount[]
  payeeMappings       PayeeEnvelopeMapping[]
  pushSubscriptions   PushSubscription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App models ─────────────────────────────────────────────────────

model Envelope {
  id              String  @id @default(cuid())
  userId          String
  name            String
  monthlyAllotment Float  @default(0)
  color           String  @default("#F7931A")
  icon            String?
  archived        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  pendingTransactions PendingTransaction[]
  shortcuts           TransactionShortcut[]
  payeeMappings       PayeeEnvelopeMapping[]

  @@index([userId])
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  envelopeId String
  date       DateTime
  payee      String   // encrypted for privacy
  amount     Float
  type       String   // "expense" | "credit"
  tags       String   @default("[]") // JSON array of tag names
  notes      String?
  satsAmount Int?     // BTC equivalent in satoshis (1 BTC = 100,000,000 sats)
  source     String   @default("manual")

  recurringId String?

  createdAt DateTime @default(now())

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope  Envelope              @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  recurring RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([envelopeId])
  @@index([date])
  @@index([recurringId])
}

model RecurringTransaction {
  id         String   @id @default(cuid())
  userId     String
  envelopeId String
  payee      String
  amount     Float
  type       String   // "expense" | "credit"
  tags       String   @default("[]")
  notes      String?  // encrypted for privacy
  cadence    String   // "weekly" | "biweekly" | "monthly" | "quarterly" | "annual"

  nextDueDate DateTime
  endDate     DateTime?
  active      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope     Envelope      @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([active, nextDueDate])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  name   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model EmailCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model BtcPriceCache {
  id       String   @id @default(cuid())
  date     String   @unique // YYYY-MM-DD
  priceUsd Float
  fetchedAt DateTime @default(now())
}

// ─── Low-friction capture models ────────────────────────────────────

model PendingTransaction {
  id                  String    @id @default(cuid())
  userId              String
  source              String
  payee               String
  amount              Float
  date                DateTime
  notes               String?
  suggestedEnvelopeId String?
  confidence          Float
  rawInput            String?
  tags                String?
  createdAt           DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope Envelope? @relation(fields: [suggestedEnvelopeId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
}

model TransactionShortcut {
  id            String   @id @default(cuid())
  userId        String
  payee         String
  defaultAmount Float?
  envelopeId    String
  label         String?
  usageCount    Int      @default(0)
  createdAt     DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope Envelope @relation(fields: [envelopeId], references: [id])

  @@index([userId])
}

model ApprovedReceiptSender {
  id            String   @id @default(cuid())
  senderPattern String   @unique
  displayName   String
  addedBy       String
  createdAt     DateTime @default(now())

  admin User @relation("ApprovedSenderAdmin", fields: [addedBy], references: [id])
}

model PendingSenderReview {
  id              String   @id @default(cuid())
  senderAddress   String
  samplePayee     String?
  sampleAmount    Float?
  occurrenceCount Int      @default(1)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  status          String   @default("pending")
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  admin User @relation("AuditLogAdmin", fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([action])
  @@index([createdAt])
}

model PlaidItem {
  id                     String   @id @default(cuid())
  userId                 String
  plaidItemId            String   @unique
  accessToken            String
  institutionName        String?
  consentTimestamp       DateTime @default(now())
  createdAt              DateTime @default(now())
  transactionsSyncCursor String?

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts PlaidAccount[]

  @@index([userId])
}

model PlaidImportedTransaction {
  id                 String   @id @default(cuid())
  userId             String
  plaidTransactionId String   @unique
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PlaidAccount {
  id          String @id @default(cuid())
  plaidItemId String
  accountName String
  mask        String?
  type        String

  plaidItem PlaidItem @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
}

model PayeeEnvelopeMapping {
  id         String @id @default(cuid())
  userId     String
  payeeHash  String
  envelopeId String
  count      Int    @default(1)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@unique([userId, payeeHash])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ConnectedEmailAccount {
  id           String    @id @default(cuid())
  userId       String
  provider     String
  accessToken  String
  refreshToken String?
  email        String
  lastScanAt   DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
